--- a/Kbuild	2026-10-31 21:45:58.000000000 +0800
+++ b/Kbuild	2026-10-31 23:57:17.081603676 +0800
@@ -64,7 +64,7 @@
 
 LOCAL_GIT_EXISTS := $(shell test -e $(KSU_SRC)/../.git && echo 1 || echo 0)
 
-ifeq ($(LOCAL_GIT_EXISTS),0)
